<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.VistaCatalogoController">
   <children>
      <HBox alignment="CENTER_LEFT" prefHeight="75.0" prefWidth="900.0" spacing="20.0" style="-fx-background-color: #003399;" styleClass="header-shop" stylesheets="@vistalogin.css">
         <children>
            <Label style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: white;" text="QUANTIX SHOP" />
            <TextField prefHeight="35.0" prefWidth="350.0" promptText="🔍 Buscar producto..." style="-fx-background-radius: 20;" styleClass="search-bar" />
            
            <Region HBox.hgrow="ALWAYS" />
            
            <Button fx:id="btnSesion" mnemonicParsing="false" onAction="#manejarAccionSesion" style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8 15; -fx-cursor: hand; -fx-background-radius: 5;" text="Cerrar Sesión" />
         </children>
         <padding>
            <Insets left="30.0" right="30.0" />
         </padding>
      </HBox>

      <ScrollPane fitToWidth="true" prefHeight="525.0" prefWidth="900.0" style="-fx-background-color: transparent;">
         <content>
            <VBox alignment="TOP_CENTER" spacing="25.0" style="-fx-background-color: #F9FAFB; -fx-padding: 40;">
               <children>
                  <Label style="-fx-font-size: 28; -fx-font-weight: bold; -fx-text-fill: #111827;" text="Explora nuestro catálogo" />
                  
                  <FlowPane fx:id="contenedorProductos" alignment="CENTER" hgap="25.0" prefWrapLength="800.0" vgap="25.0" />
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </children>
</VBox>
