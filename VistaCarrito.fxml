<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1260.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.VistaCarritoController">
   <top>
      <VBox>
         <children>
            <HBox alignment="CENTER_LEFT" prefHeight="165.0" spacing="36.0" style="-fx-background-color: #1f3f90;">
               <children>
                  <VBox alignment="CENTER" prefHeight="165.0" prefWidth="415.0" style="-fx-background-color: white;">
                     <children>
                        <Label style="-fx-font-size: 54; -fx-font-weight: bold; -fx-text-fill: #2870d8;" text="QUANTIX" />
                        <Label style="-fx-font-size: 30; -fx-font-weight: bold; -fx-text-fill: #111827;" text="SHOP" />
                     </children>
                  </VBox>
                  <TextField prefHeight="64.0" prefWidth="365.0" promptText="Buscar producto" style="-fx-font-size: 24; -fx-background-color: white;" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button onAction="#irFavoritos" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 42;" text="♡" />
                  <Button onAction="#irCarrito" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 40;" text="🛒" />
                  <Button onAction="#volverCatalogo" style="-fx-background-color: white; -fx-text-fill: #1f3f90; -fx-font-weight: bold;" text="Catalogo" />
               </children>
               <padding>
                  <Insets right="40.0" />
               </padding>
            </HBox>
            <Label alignment="CENTER" maxWidth="Infinity" prefHeight="82.0" style="-fx-font-size: 36; -fx-text-fill: #1f2937;" text="Carrito de Compras" />
         </children>
      </VBox>
   </top>
   <center>
      <HBox maxHeight="500.0" maxWidth="1090.0" spacing="20.0" style="-fx-border-color: black; -fx-border-radius: 10; -fx-border-width: 2; -fx-padding: 12;">
         <children>
            <ScrollPane fitToWidth="true" prefHeight="465.0" prefWidth="685.0" style="-fx-background-color: transparent;">
               <content>
                  <VBox fx:id="contenedorCarrito" spacing="0.0" style="-fx-border-color: #9ca3af;" />
               </content>
            </ScrollPane>
            <VBox prefHeight="312.0" prefWidth="330.0" spacing="22.0" style="-fx-border-color: #9ca3af; -fx-padding: 14;">
               <children>
                  <Label style="-fx-font-size: 20;" text="Resumen del Carrito de Compras" />
                  <Region prefHeight="1.0" style="-fx-background-color: #9ca3af;" />
                  <HBox>
                     <children>
                        <Label style="-fx-font-size: 20;" text="Subtotal:" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblSubtotal" style="-fx-font-size: 20;" text="\$0 usd" />
                     </children>
                  </HBox>
                  <Region prefHeight="1.0" style="-fx-background-color: #9ca3af;" />
                  <HBox>
                     <children>
                        <Label style="-fx-font-size: 20;" text="Total:" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblTotal" style="-fx-font-size: 20;" text="\$0 usd" />
                     </children>
                  </HBox>
                  <Button maxWidth="Infinity" onAction="#comprarAhora" prefHeight="38.0" style="-fx-background-color: #0057ff; -fx-text-fill: white; -fx-font-size: 20; -fx-background-radius: 18;" text="Comprar Ahora" />
               </children>
            </VBox>
         </children>
      </HBox>
   </center>
</BorderPane>
